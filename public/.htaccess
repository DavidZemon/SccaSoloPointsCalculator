<IfModule mod_headers.c>
    # Don't let the index be cached. Everything else has a filename suffixed with a unique hash based on the content,
    # so it's fine to cache that, but the index can't follow that pattern and if it's cached, nothing else gets loaded
    # correctly.
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Content-hashed assets can be cached indefinitely - their filenames change
    # whenever their content changes, so there is no risk of stale responses.
    <FilesMatch "\.(js|css|map)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

